@startuml
!theme plain

[*] --> UI_Загрузка : открыть приложение

UI_Загрузка : entry / показать экран загрузки
UI_Загрузка : do / инициализация компонентов интерфейса
UI_Загрузка : do / проверка соединения с сервером БД
UI_Загрузка : exit / скрыть заставку
UI_Загрузка --> UI_Авторизация : компоненты загружены

UI_Авторизация : entry / показать форму входа
UI_Авторизация : do / ввод логина и пароля
UI_Авторизация : do / валидация учетных данных
UI_Авторизация : exit / сохранить сессию и роль (Клиент/Админ)
UI_Авторизация : exit / скрыть форму входа
UI_Авторизация --> UI_ГлавноеМеню : успех входа
UI_Авторизация --> UI_Ошибка : ошибка входа

UI_Ошибка : entry / показать диалог ошибки
UI_Ошибка : do / вывод информации о неверных данных
UI_Ошибка : exit / скрыть диалог
UI_Ошибка --> UI_Авторизация : повтор

state UI_ГлавноеМеню {
  [*] --> UI_РабочийСтол
  
  UI_РабочийСтол : entry / отобразить главную панель системы
  UI_РабочийСтол : do / загрузка виджетов в зависимости от роли
  UI_РабочийСтол : exit / очистить область панели
  
  ' --- Сценарий Клиента ---
  UI_РабочийСтол --> UI_ПоискНомеров : переход к бронированию
  
  UI_ПоискНомеров : entry / показать интерфейс поиска
  UI_ПоискНомеров : do / ввод дат заезда/выезда, настройка фильтров
  UI_ПоискНомеров : exit / сформировать параметры запроса
  UI_ПоискНомеров --> UI_ВыборНомера : поиск выполнен
  UI_ПоискНомеров --> UI_РабочийСтол : возврат
  
  UI_ВыборНомера : entry / отобразить список доступных номеров
  UI_ВыборНомера : do / просмотр карточек номеров, выбор варианта
  UI_ВыборНомера : exit / зафиксировать выбранный номер
  UI_ВыборНомера --> UI_ОформлениеБрони : подтвердить выбор
  UI_ВыборНомера --> UI_ПоискНомеров : изменить параметры поиска
  
  UI_ОформлениеБрони : entry / показать детали брони и форму оплаты
  UI_ОформлениеБрони : do / подтверждение бронирования клиентом
  UI_ОформлениеБрони : exit / отправить заявку в БД, уведомить админа
  UI_ОформлениеБрони --> UI_РабочийСтол : бронь успешна / отмена
  
  ' --- Сценарий Администратора ---
  UI_РабочийСтол --> UI_УправлениеФондом : переход в панель администратора
  
  UI_УправлениеФондом : entry / отобразить список актуальных бронирований
  UI_УправлениеФондом : do / просмотр заявок, регистрация заезда/выезда
  UI_УправлениеФондом : do / изменение статуса номера (свободен, занят, уборка)
  UI_УправлениеФондом : exit / обновить данные в системе
  UI_УправлениеФондом --> UI_РабочийСтол : возврат
  
  UI_РабочийСтол --> [*] : выход
}

UI_ГлавноеМеню --> UI_Выход : выход

UI_Выход : entry / показать экран прощания
UI_Выход : do / удаление токенов сессии, очистка состояния
UI_Выход : exit / завершение работы UI
UI_Выход --> [*] : закрыть приложение
@enduml