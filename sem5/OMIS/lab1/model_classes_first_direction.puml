@startuml НаправлениеРазвития_ОнлайнОплата
!theme plain
top to bottom direction

'========================================
' ЛЕГЕНДА
'========================================
legend top left
  |<back:#90EE90> Новые классы </back>| Добавленные классы
  |<back:#FFFFFF> Существующие </back>| Существующие классы
endlegend

'========================================
' ПАКЕТ: МОДЕЛЬ
'========================================
package "Модель" as Model {
    '=== Существующие классы ===
    class "Бронирование" as Booking {
    }
    class "Клиент" as Client {
    }
    
    '=== НОВЫЕ классы для онлайн-оплаты ===
    class "Счет" as Invoice #90EE90 {
        +идСчета: String
        +сумма: Double
        +датаВыставления: Date
        +статус: String
    }
    class "Платеж" as Payment #90EE90 {
        +идПлатежа: String
        +сумма: Double
        +методОплаты: String
        +статус: String
        +датаТранзакции: Date
    }
    class "БанковскаяКарта" as CreditCard #90EE90 {
        +токенКарты: String
        +последниеЦифры: String
        +срокДействия: String
    }
    
    '=== НОВЫЕ репозитории ===
    class "РепозиторийСчетов" as InvoiceRepo #90EE90 {
        +сохранитьСчет(счет: Счет): void
        +найтиПоБронированию(идБрони: String): Счет
    }
    class "РепозиторийПлатежей" as PaymentRepo #90EE90 {
        +сохранитьПлатеж(платеж: Платеж): void
        +найтиПоСчету(идСчета: String): List<Платеж>
    }

    Booking "1" o-- "0..1" Invoice : +счет
    Invoice "1" o-- "0..*" Payment : +платежи
    Client "1" o-- "0..*" CreditCard : +сохраненныеКарты
    InvoiceRepo "1" o-- "0..*" Invoice : +счета
    PaymentRepo "1" o-- "0..*" Payment : +базаПлатежей
}

'========================================
' ПАКЕТ: КОНТРОЛЛЕРЫ
'========================================
package "Контроллеры" as Controllers {
    '=== Существующие классы ===
    class "КонтроллерБронирования" as BookingCtrl {
    }
    
    '=== НОВЫЙ контроллер оплаты ===
    class "КонтроллерОплаты" as PaymentCtrl #90EE90 {
        +выставитьСчет(бронирование: Бронирование): Счет
        +обработатьПлатеж(счет: Счет, карта: БанковскаяКарта): Платеж
        +проверитьСтатусОплаты(идСчета: String): String
        +оформитьВозврат(идПлатежа: String): void
    }
    
    '=== Паттерн Адаптер для внешнего банка ===
    interface "IШлюзОплаты" as IPaymentGateway <<interface>> #90EE90 {
        +провестиТранзакцию(сумма: Double, токенКарты: String): Boolean
        +вернутьСредства(идТранзакции: String): Boolean
    }
    
    class "АдаптерБанка" as BankAdapter #90EE90 {
        +провестиТранзакцию(сумма: Double, токенКарты: String): Boolean
        +вернутьСредства(идТранзакции: String): Boolean
    }
    
    BankAdapter ..|> IPaymentGateway
    PaymentCtrl "1" o-- "1" IPaymentGateway : +шлюзОплаты
    PaymentCtrl "1" o-- "1" InvoiceRepo : +репозиторийСчетов
    PaymentCtrl "1" o-- "1" PaymentRepo : +репозиторийПлатежей
    
    'Связь существующего процесса с новым
    BookingCtrl ..> PaymentCtrl : <<использует>>
}

'========================================
' ПАКЕТ: ПРЕДСТАВЛЕНИЕ
'========================================
package "Представление" as View {
    '=== Существующие интерфейсы ===
    interface "IПредставление" as IView <<interface>> {
    }
    
    '=== НОВЫЙ интерфейс для экрана оплаты ===
    interface "IПредставлениеОплаты" as IPaymentView <<interface>> #90EE90 {
        +отобразитьФормуОплаты(счет: Счет): void
        +показатьСтатусТранзакции(статус: String): void
        +отобразитьЭлектронныйЧек(платеж: Платеж): void
    }
    
    IView <|-- IPaymentView
    IPaymentView "1" --> "1" PaymentCtrl : +контроллер
}

'========================================
' ИНФРАСТРУКТУРА
'========================================
package "Инфраструктура" as Infra {
    class "КонтейнерЗависимостей" as DIContainer <<injector>> {
    }
    
    '=== НОВАЯ фабрика для подсистемы оплаты ===
    class "ФабрикаОплаты" as PaymentFactory <<injector>> #90EE90 {
        +создатьКонтроллерОплаты(репозитории: List, шлюз: IШлюзОплаты): КонтроллерОплаты
        +создатьШлюзОплаты(): IШлюзОплаты
        +создатьПредставлениеОплаты(контроллер: КонтроллерОплаты): IПредставлениеОплаты
    }
    
    DIContainer "1" o-- "1" PaymentFactory : +фабрикаОплаты
    PaymentFactory ..> PaymentCtrl : <<создает>>
    PaymentFactory ..> BankAdapter : <<создает>>
    PaymentFactory ..> IPaymentView : <<создает>>
}

Controllers -[hidden]down- Model
Infra -[hidden]down- Controllers

@enduml