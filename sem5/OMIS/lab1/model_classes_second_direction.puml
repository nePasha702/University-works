@startuml НаправлениеРазвития_ПрограммаЛояльности
!theme plain
top to bottom direction

'========================================
' ЛЕГЕНДА
'========================================
legend top left
  |<back:#FFB6C1> Новые классы </back>| Добавленные классы
  |<back:#FFFFFF> Существующие </back>| Существующие классы
endlegend

'========================================
' ПАКЕТ: МОДЕЛЬ
'========================================
package "Модель" as Model {
    '=== Существующие классы ===
    class "Клиент" as Client {
    }
    class "Бронирование" as Booking {
    }

    '=== НОВЫЕ классы программы лояльности ===
    class "УровеньЛояльности" as LoyaltyTier #FFB6C1 {
        +название: String
        +процентСкидки: Double
        +множительБаллов: Double
        +порогПерехода: Double
    }

    class "СчетЛояльности" as LoyaltyAccount #FFB6C1 {
        +идСчета: String
        +балансБаллов: Integer
        +общаяСуммаТрат: Double
        +проверитьИОбновитьУровень(): void
    }

    class "ТранзакцияЛояльности" as LoyaltyTransaction #FFB6C1 {
        +идТранзакции: String
        +типОперации: String
        +количествоБаллов: Integer
        +датаТранзакции: Date
        +описание: String
    }

    '=== НОВЫЕ Репозитории ===
    class "РепозиторийСчетовЛояльности" as LoyaltyAccRepo #FFB6C1 {
        +найтиПоКлиенту(идКлиента: String): СчетЛояльности
        +сохранить(счет: СчетЛояльности): void
    }

    class "РепозиторийТранзакцийЛояльности" as LoyaltyTransRepo #FFB6C1 {
        +получитьИсторию(идСчета: String): List<ТранзакцияЛояльности>
        +сохранить(транзакция: ТранзакцияЛояльности): void
    }

    Client "1" o-- "0..1" LoyaltyAccount : +счетЛояльности
    LoyaltyAccount "1" o-- "1" LoyaltyTier : +текущийУровень
    LoyaltyAccount "1" o-- "0..*" LoyaltyTransaction : +историяТранзакций
    LoyaltyAccRepo "1" o-- "0..*" LoyaltyAccount : +счета
    LoyaltyTransRepo "1" o-- "0..*" LoyaltyTransaction : +транзакции
}

'========================================
' ПАКЕТ: КОНТРОЛЛЕРЫ
'========================================
package "Контроллеры" as Controllers {
    '=== Существующие классы ===
    class "КонтроллерБронирования" as BookingCtrl {
    }

    '=== Паттерн Стратегия для расчета скидок и баллов ===
    interface "IСтратегияПрограммыЛояльности" as ILoyaltyStrategy <<interface>> #FFB6C1 {
        +рассчитатьБаллы(сумма: Double, уровень: УровеньЛояльности): Integer
        +рассчитатьСкидку(сумма: Double, уровень: УровеньЛояльности): Double
    }

    class "СтандартнаяСтратегияЛояльности" as StandardStrategy #FFB6C1 {
        +рассчитатьБаллы(сумма: Double, уровень: УровеньЛояльности): Integer
        +рассчитатьСкидку(сумма: Double, уровень: УровеньЛояльности): Double
    }

    StandardStrategy ..|> ILoyaltyStrategy

    '=== НОВЫЙ контроллер ===
    class "КонтроллерЛояльности" as LoyaltyCtrl #FFB6C1 {
        +начислитьБаллыЗаПроживание(бронирование: Бронирование): void
        +применитьСкидкуКБронированию(бронирование: Бронирование): Double
        +списатьБаллы(идКлиента: String, количество: Integer): Boolean
        +получитьСтатусЛояльности(идКлиента: String): СчетЛояльности
    }

    LoyaltyCtrl "1" o-- "1" ILoyaltyStrategy : +стратегия
    LoyaltyCtrl "1" o-- "1" LoyaltyAccRepo : +репозиторийСчетов
    LoyaltyCtrl "1" o-- "1" LoyaltyTransRepo : +репозиторийТранзакций

    BookingCtrl ..> LoyaltyCtrl : <<использует>>
}

'========================================
' ПАКЕТ: ПРЕДСТАВЛЕНИЕ
'========================================
package "Представление" as View {
    '=== Существующие интерфейсы ===
    interface "IПредставление" as IView <<interface>> {
    }

    '=== НОВЫЙ интерфейс для экрана лояльности ===
    interface "IПредставлениеЛояльности" as ILoyaltyView <<interface>> #FFB6C1 {
        +отобразитьБалансБаллов(счет: СчетЛояльности): void
        +отобразитьДоступнуюСкидку(скидка: Double): void
        +показатьИсториюНачислений(транзакции: List<ТранзакцияЛояльности>): void
    }

    IView <|-- ILoyaltyView
    ILoyaltyView "1" --> "1" LoyaltyCtrl : +контроллер
}

'========================================
' ИНФРАСТРУКТУРА
'========================================
package "Инфраструктура" as Infra {
    class "КонтейнерЗависимостей" as DIContainer <<injector>> {
    }

    '=== НОВАЯ фабрика для подсистемы лояльности ===
    class "ФабрикаЛояльности" as LoyaltyFactory <<injector>> #FFB6C1 {
        +создатьКонтроллерЛояльности(репозитории: List, стратегия: IСтратегияПрограммыЛояльности): КонтроллерЛояльности
        +создатьСтратегиюЛояльности(): IСтратегияПрограммыЛояльности
        +создатьПредставлениеЛояльности(контроллер: КонтроллерЛояльности): IПредставлениеЛояльности
    }

    DIContainer "1" o-- "1" LoyaltyFactory : +фабрикаЛояльности
    LoyaltyFactory ..> LoyaltyCtrl : <<создает>>
    LoyaltyFactory ..> StandardStrategy : <<создает>>
    LoyaltyFactory ..> ILoyaltyView : <<создает>>
}

Controllers -[hidden]down- Model
Infra -[hidden]down- Controllers

@enduml